{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/jobs/confirmations/",
      "destination": "/api/jobs/confirmations"
    },
    {
      "source": "/api/jobs/reconcile-subscriptions/",
      "destination": "/api/jobs/reconcile-subscriptions"
    },
    {
      "source": "/api/reviews/send/",
      "destination": "/api/reviews/send"
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/confirmations",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/reviews/send",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/jobs/reconcile-subscriptions",
      "schedule": "0 2 * * *"
    }
  ]
}
