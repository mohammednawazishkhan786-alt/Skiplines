{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/jobs/confirmations",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/reviews/send",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/jobs/reconcile-subscriptions",
      "schedule": "0 2 * * *"
    }
  ]
}
