# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local e2e / audit artifacts (never commit)
.e2e-email.tmp
.e2e-preview-state.json
.e2e-prod-acceptance-state.json
.lighthouse-desktop.json
.lighthouse-mobile.json

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
